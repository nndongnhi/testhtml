              <div class="step" style="--a:14%;height:36%"><b>L1</b><span>Chat trợ lý</span></div>
              <div class="step" style="--a:24%;height:56%"><b>L2</b><span>Prompt và context</span></div>
              <div class="step" style="--a:36%;height:78%"><b>L3</b><span>Workflow agentic</span></div>
              <div class="step" style="--a:52%;height:100%"><b>L4</b><span>Evals và ContextOps</span></div>
            </div>
