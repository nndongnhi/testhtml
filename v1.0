        <tbody>
          <tr data-levels="L3" tabindex="0"><td class="id" data-c="0">UC5</td><td data-c="1">Transcript thành minutes, decisions, open questions</td><td data-c="2">E&amp;C</td><td data-c="3">L3</td><td data-c="4"><span class="pill yes">Có</span></td><td data-c="5"><span class="pill">Chưa</span></td></tr>
          <tr data-levels="L3 L4" tabindex="0"><td class="id" data-c="0">UC6</td><td data-c="1">Triage request từ Slack, email, ticket</td><td data-c="2">E&amp;C</td><td data-c="3">L3–L4</td><td data-c="4"><span class="pill yes">Có</span></td><td data-c="5"><span class="pill yes">Đủ</span></td></tr>
          <tr data-levels="L2" tabindex="0"><td class="id" data-c="0">UC7</td><td data-c="1">Prioritization và sign-off baseline</td><td data-c="2">RLCM</td><td data-c="3">L2</td><td data-c="4"><span class="pill yes">Có</span></td><td data-c="5"><span class="pill">Chưa</span></td></tr>
          <tr data-levels="L4" tabindex="0"><td class="id" data-c="0">UC8</td><td data-c="1">Duy trì traceability matrix</td><td data-c="2">RLCM</td><td data-c="3">L4</td><td data-c="4"><span class="pill yes">Có</span></td><td data-c="5"><span class="pill part">Một phần</span></td></tr>
          <tr data-levels="L3" tabindex="0"><td class="id" data-c="0">UC9</td><td data-c="1">Phân tích tác động khi yêu cầu thay đổi</td><td data-c="2">RLCM</td><td data-c="3">L3</td><td data-c="4"><span class="pill yes">Có</span></td><td data-c="5"><span class="pill">Chưa</span></td></tr>
          <tr data-levels="L3" tabindex="0"><td class="id" data-c="0">UC13</td><td data-c="1">Đánh giá cơ hội tự động hóa bằng AI agent</td><td data-c="2">SA</td><td data-c="3">L3</td><td data-c="4"><span class="pill yes">Có</span></td><td data-c="5"><span class="pill">Chưa</span></td></tr>
          <tr data-levels="L3 L4" tabindex="0"><td class="id" data-c="0">UC15</td><td data-c="1">Đặc tả FR, NFR, technical</td><td data-c="2">RADD</td><td data-c="3">L3–L4</td><td data-c="4"><span class="pill yes">Có</span></td><td data-c="5"><span class="pill yes">Đủ</span></td></tr>
          <tr data-levels="L3 L4" tabindex="0"><td class="id" data-c="0">UC19</td><td data-c="1">UAT: kế hoạch, review test case, triage defect</td><td data-c="2">SE</td><td data-c="3">L3–L4</td><td data-c="4"><span class="pill yes">Có</span></td><td data-c="5"><span class="pill part">Chưa điều phối</span></td></tr>
        </tbody>
      </table>
    </div>
  </section>
