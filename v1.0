</section>
</main>
<footer>
  <div class="wrap">Trang demo một file, không phụ thuộc thư viện ngoài. Mỗi component nằm trong một khối JS riêng ở cuối file nên có thể tách ra dùng lại.</div>
</footer>
<script>
(function(){
  'use strict';
  var $=function(s,r){return (r||document).querySelector(s)};
  var $$=function(s,r){return Array.prototype.slice.call((r||document).querySelectorAll(s))};

  /* ===== Nav + scrollspy ===== */
  (function(){
    var links=$$('#navlinks a');
    links.forEach(function(a){
      a.addEventListener('click',function(e){
        var id=a.getAttribute('href').slice(1), el=document.getElementById(id);
        if(!el) return;
        e.preventDefault();
        el.scrollIntoView();
        try{history.replaceState(null,'','#'+id)}catch(err){}
      });
    });
    function spy(){
      var y=window.scrollY+120, cur=null;
      links.forEach(function(a){
        var el=document.getElementById(a.getAttribute('href').slice(1));
        if(el && el.offsetTop<=y) cur=a;
      });
      links.forEach(function(a){ if(a===cur) a.setAttribute('aria-current','true'); else a.removeAttribute('aria-current'); });
    }
    window.addEventListener('scroll',spy,{passive:true});
    spy();
  })();

  /* ===== Flow diagram ===== */
  (function(){
    var steps=[
      {kind:'agent',label:'Agent',name:'Intake',short:'Nhận request từ Slack, email, ticket',gate:false,
       owner:'Agent intake',inp:'Tin nhắn, email, ticket thô',out:'Request đã chuẩn hóa',guard:'Không tự thêm số liệu. Thiếu thông tin thì ghi OPEN QUESTION.'},
      {kind:'agent',label:'Agent',name:'Triage',short:'Phân loại type, priority, system, có cần tách không',gate:true,
       owner:'Agent triage',inp:'Request đã chuẩn hóa',out:'Triage card',guard:'Sai ở bước này thì sai dây chuyền phía sau, nên BA xác nhận phân loại trước khi đi tiếp.'},
      {kind:'agent',label:'Agent',name:'Requirements',short:'Soạn FR, NFR, user story kèm AC',gate:false,
       owner:'Agent requirements',inp:'Triage card đã duyệt, phần KB liên quan',out:'Requirements pack (FR, NFR, story, AC Given/When/Then)',guard:'Mọi quy tắc phải cite [KB: file#ID].'},
      {kind:'code',label:'Code + critic',name:'Critic và kiểm tra',short:'Soi độc lập, chạy script tất định',gate:true,
       owner:'Subagent critic và script hook',inp:'Chỉ file requirements, không có lập luận của drafter',out:'Finding xếp theo severity',guard:'Tối đa 2 vòng viết và soi, sau đó chuyển cho người. BA accept hoặc reject từng finding.'},
      {kind:'agent',label:'Agent',name:'Publish',short:'Ghi ra Jira, Confluence',gate:false,
       owner:'Agent publish',inp:'Pack đã được duyệt',out:'Issue Jira, trang Confluence',guard:'Ghi ra hệ thống ngoài chỉ sau khi có approve, vì khó đảo ngược.'}
    ];
    var arrow='<svg width="36" height="12" viewBox="0 0 40 12" aria-hidden="true"><path d="M0 6h34M28 1l7 5-7 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    var box=$('#flowDiagram'), detail=$('#flowDetail'), pinned=1;
    var html='';
    steps.forEach(function(s,i){
      html+='<button type="button" class="node '+s.kind+'" data-i="'+i+'">'
        +'<span class="kind">'+s.label+'</span><strong>'+s.name+'</strong><span class="d">'+s.short+'</span>'
        +(s.gate?'<span class="gate">Người duyệt</span>':'')+'</button>';
      if(i<steps.length-1) html+='<span class="link" aria-hidden="true">'+arrow+'</span>';
    });
    box.innerHTML=html;
    var nodes=$$('.node',box), links=$$('.link',box);
    function show(i){
      var s=steps[i];
      nodes.forEach(function(n,k){n.classList.toggle('is-active',k===i)});
      links.forEach(function(l,k){l.classList.toggle('on',k===i-1||k===i)});
      box.classList.add('has-active');
      detail.innerHTML='<h3>'+s.name+'<small>bước '+(i+1)+' / '+steps.length+'</small></h3>'
        +'<dl><dt>Ai làm</dt><dd>'+s.owner+'</dd></dl>'
        +'<dl><dt>Đầu vào</dt><dd>'+s.inp+'</dd></dl>'
        +'<dl><dt>Đầu ra</dt><dd>'+s.out+'</dd></dl>'
        +'<dl class="'+(s.gate?'human':'')+'"><dt>'+(s.gate?'Checkpoint':'Guardrail')+'</dt><dd>'+s.guard+'</dd></dl>';
    }
    nodes.forEach(function(n){
      var i=+n.dataset.i;
      n.addEventListener('mouseenter',function(){show(i)});
      n.addEventListener('focus',function(){show(i)});
      n.addEventListener('click',function(){pinned=i;show(i)});
    });
    box.addEventListener('mouseleave',function(){show(pinned)});
    show(pinned);
  })();

  /* ===== Tabs ===== */
  (function(){
    var tabs=$$('[role=tab]'), panels=$$('[role=tabpanel]');
    function select(i,focus){
      tabs.forEach(function(t,k){
        var on=k===i;
        t.setAttribute('aria-selected',on?'true':'false');
        t.tabIndex=on?0:-1;
        panels[k].hidden=!on;
      });
      if(focus) tabs[i].focus();
    }
    tabs.forEach(function(t,i){
      t.addEventListener('click',function(){select(i,false)});
      t.addEventListener('keydown',function(e){
        var n=tabs.length, k=null;
        if(e.key==='ArrowRight') k=(i+1)%n;
        else if(e.key==='ArrowLeft') k=(i-1+n)%n;
        else if(e.key==='Home') k=0;
        else if(e.key==='End') k=n-1;
        if(k!==null){e.preventDefault();select(k,true)}
      });
    });
  })();

  /* ===== Copy ===== */
  $$('.copy').forEach(function(b){
    b.addEventListener('click',function(){
      var src=document.getElementById(b.dataset.copy), txt=src.textContent, old=b.textContent;
      function done(m){b.textContent=m;setTimeout(function(){b.textContent=old},1600)}
      try{
        navigator.clipboard.writeText(txt).then(function(){done('Đã chép')},function(){fallback()});
      }catch(err){fallback()}
      function fallback(){
        try{
          var r=document.createRange(); r.selectNodeContents(src);
          var sel=window.getSelection(); sel.removeAllRanges(); sel.addRange(r);
        }catch(e2){}
        done('Chọn và Ctrl+C');
      }
    });
  });

  /* ===== Accordion ===== */
  (function(){
    var btns=$$('.acc-btn');
    function set(b,open){
      var p=document.getElementById(b.getAttribute('aria-controls'));
      b.setAttribute('aria-expanded',open?'true':'false');
      p.classList.toggle('open',open);
      p.inert=!open;
    }
    btns.forEach(function(b){
      set(b,b.getAttribute('aria-expanded')==='true');
      b.addEventListener('click',function(){set(b,b.getAttribute('aria-expanded')!=='true')});
    });
    $('#accOpen').addEventListener('click',function(){btns.forEach(function(b){set(b,true)})});
    $('#accClose').addEventListener('click',function(){btns.forEach(function(b){set(b,false)})});
  })();

  /* ===== Hover highlight (crosshair + level filter) ===== */
  (function(){
    var tbl=$('#uc'), body=$('tbody',tbl), rows=$$('tr',body), pinned=null;
    function clear(){
      $$('.hl-row',tbl).forEach(function(r){r.classList.remove('hl-row')});
      $$('.hl-col',tbl).forEach(function(c){c.classList.remove('hl-col')});
    }
    tbl.addEventListener('mouseover',function(e){
      var cell=e.target.closest('td,th');
      if(!cell||body.classList.contains('filtering')) return;
      clear();
      var c=cell.dataset.c;
      $$('[data-c="'+c+'"]',tbl).forEach(function(x){x.classList.add('hl-col')});
      var row=cell.closest('tbody tr'); if(row) row.classList.add('hl-row');
    });
    tbl.addEventListener('mouseleave',clear);
    rows.forEach(function(r){
      r.addEventListener('focus',function(){clear();r.classList.add('hl-row')});
      r.addEventListener('blur',clear);
    });

    var chips=$$('.fchip');
    function filter(level){
      if(!level){body.classList.remove('filtering');rows.forEach(function(r){r.classList.remove('match')});return}
      clear();
      body.classList.add('filtering');
      rows.forEach(function(r){r.classList.toggle('match',r.dataset.levels.split(' ').indexOf(level)>-1)});
    }
    chips.forEach(function(c){
      c.addEventListener('mouseenter',function(){filter(c.dataset.level)});
      c.addEventListener('focus',function(){filter(c.dataset.level)});
      c.addEventListener('mouseleave',function(){filter(pinned)});
      c.addEventListener('blur',function(){filter(pinned)});
      c.addEventListener('click',function(){
        pinned=(pinned===c.dataset.level)?null:c.dataset.level;
        chips.forEach(function(x){x.setAttribute('aria-pressed',x.dataset.level===pinned?'true':'false')});
        filter(pinned);
      });
    });
  })();

  /* ===== Slide viewer ===== */
  (function(){
    var stage=$('#stage'), slides=$$('.slide',stage), rail=$('#rail'), n=slides.length, cur=0, timer=null;
    var prev=$('#prev'), next=$('#next'), count=$('#count'), bar=$('#bar'), auto=$('#auto');
    slides.forEach(function(s,i){
      var li=document.createElement('li'), b=document.createElement('button');
      b.type='button';
      b.innerHTML='<span class="rn">'+(i+1)+'</span><span>'+s.dataset.title+'</span>';
      b.addEventListener('click',function(){go(i)});
      li.appendChild(b); rail.appendChild(li);
    });
    var rb=$$('button',rail);
    function go(i){
      cur=Math.max(0,Math.min(n-1,i));
      slides.forEach(function(s,k){s.classList.toggle('is-current',k===cur); s.setAttribute('aria-hidden',k===cur?'false':'true')});
      rb.forEach(function(b,k){ if(k===cur) b.setAttribute('aria-current','true'); else b.removeAttribute('aria-current')});
      count.textContent=(cur+1)+' / '+n;
      bar.style.width=((cur+1)/n*100)+'%';
      prev.disabled=cur===0; next.disabled=cur===n-1;
    }
    prev.addEventListener('click',function(){go(cur-1)});
    next.addEventListener('click',function(){go(cur+1)});
    stage.addEventListener('keydown',function(e){
      var k=null;
      if(e.key==='ArrowRight'||e.key==='PageDown'||e.key===' ') k=cur+1;
      else if(e.key==='ArrowLeft'||e.key==='PageUp') k=cur-1;
      else if(e.key==='Home') k=0;
      else if(e.key==='End') k=n-1;
      if(k!==null){e.preventDefault();go(k)}
    });
    stage.addEventListener('click',function(){stage.focus()});
    var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if(reduce){auto.disabled=true;auto.title='Tắt vì thiết bị yêu cầu giảm chuyển động'}
    function stop(){clearInterval(timer);timer=null;auto.setAttribute('aria-pressed','false');auto.textContent='Tự chạy'}
    auto.addEventListener('click',function(){
      if(timer){stop();return}
      auto.setAttribute('aria-pressed','true');auto.textContent='Dừng';
      timer=setInterval(function(){ if(cur>=n-1){stop()} else go(cur+1) },4000);
    });
    go(0);
  })();

  /* ===== Flip cards ===== */
  $$('.flip').forEach(function(f){
    var front=$('.front',f), back=$('.back',f);
    function sync(){
      var on=f.getAttribute('aria-pressed')==='true';
      front.setAttribute('aria-hidden',on?'true':'false');
      back.setAttribute('aria-hidden',on?'false':'true');
    }
    sync();
    f.addEventListener('click',function(){
      f.setAttribute('aria-pressed',f.getAttribute('aria-pressed')==='true'?'false':'true');
      sync();
    });
  });

  /* ===== Toggle view ===== */
  (function(){
    var pairs=[
      ['Requirements gathering','Problem framing'],
      ['Process mapping','Thiết kế workflow / agent'],
      ['Business rules','Guardrails'],
      ['UAT, test cases','Evals'],
      ['Sign-off','Checkpoint human-in-the-loop'],
      ['Data requirements','Context design']
    ];
    var list=$('#maplist'), btns=$$('.seg button');
    function render(v,animate){
      var other=v===0?1:0, h='';
      pairs.forEach(function(p){
        h+='<li class="card'+(animate?' swap':'')+'"><b>'+p[v]+'</b><span>'+(v===0?'Tương đương agentic: ':'Tương đương truyền thống: ')+p[other]+'</span></li>';
      });
      list.innerHTML=h;
    }
    btns.forEach(function(b){
      b.addEventListener('click',function(){
        btns.forEach(function(x){x.setAttribute('aria-pressed',x===b?'true':'false')});
        render(+b.dataset.view,true);
      });
    });
    render(0,false);
  })();
})();
</body>
</html>
